# Copilot Studio Agent Configuration
# Copy this file to .env and fill in your values

# Environment ID where your copilot is deployed
# Format: Default-<guid>
# Find this in Power Platform Admin Center -> Environments
COPILOTSTUDIOAGENT__ENVIRONMENTID=Default-your-environment-guid-here

# Agent identifier/schema name of your copilot
# This is the unique identifier of your Copilot Studio agent
# Find this in Copilot Studio -> Settings -> Channels
COPILOTSTUDIOAGENT__SCHEMANAME=your_agent_name

# Azure AD App Registration Client ID
# Created by running ./setup_azure_app.sh or manually in Azure Portal
COPILOTSTUDIOAGENT__AGENTAPPID=

# Azure AD Tenant ID
# Your Azure AD tenant identifier
COPILOTSTUDIOAGENT__TENANTID=
